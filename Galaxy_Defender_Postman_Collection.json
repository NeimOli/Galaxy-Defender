{
  "info": {
    "_postman_id": "galaxy-defender-banana-api-collection",
    "name": "Galaxy Defender — Banana API & Backend Test Suite",
    "description": "Enterprise API Test Suite for Galaxy Defender (Software for Enterprise Assignment)\nStudent: Sagar Thapa\n\nCovers:\n1. Banana API Interoperability (Direct REST JSON validation)\n2. Banana API via Local PHP CORS Gateway\n3. Virtual Identity (Register, Login, Session Token)\n4. Telemetry & Leaderboard (Submit Score, Fetch Top Scores)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "banana_api_url",
      "value": "https://marcconrad.com/uob/banana/api.php?out=json",
      "type": "string"
    },
    {
      "key": "local_api_base",
      "value": "http://localhost/Galaxy Defender - Space Shooter Game/api/api.php",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Theme: Interoperability (Banana API)",
      "item": [
        {
          "name": "1.1 Direct Banana API Test (Live Marc Conrad Endpoint)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is valid JSON format', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test('Schema Check: contains \"question\" image URL string', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('question');",
                  "    pm.expect(data.question).to.be.a('string');",
                  "    pm.expect(data.question).to.include('http');",
                  "});",
                  "",
                  "pm.test('Schema Check: contains \"solution\" digit (0-9)', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('solution');",
                  "    var sol = parseInt(data.solution, 10);",
                  "    pm.expect(sol).to.be.a('number');",
                  "    pm.expect(sol).to.be.within(0, 9);",
                  "});",
                  "",
                  "pm.test('Response time is within acceptable gameplay threshold (< 4000ms)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(4000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{banana_api_url}}",
              "host": ["marcconrad", "com"],
              "path": ["uob", "banana", "api.php"],
              "query": [
                {
                  "key": "out",
                  "value": "json"
                }
              ]
            },
            "description": "Tests Dr. Marc Conrad's Banana API directly to verify external interoperability."
          }
        },
        {
          "name": "1.2 Banana API via Local PHP Gateway (CORS Resilience)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Gateway reports successful proxy exchange', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data).to.have.property('question');",
                  "    pm.expect(json.data).to.have.property('solution');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{local_api_base}}?action=banana",
              "query": [
                {
                  "key": "action",
                  "value": "banana"
                }
              ]
            },
            "description": "Tests the local PHP backend server-side proxy for the Banana API."
          }
        }
      ]
    },
    {
      "name": "2. Theme: Virtual Identity (Authentication & Sessions)",
      "item": [
        {
          "name": "2.1 Pilot Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test('Pilot successfully commissioned with Cadet rank', function () {",
                  "    if (json.status === 'success') {",
                  "        pm.expect(json.data).to.have.property('callsign');",
                  "        pm.expect(json.data.rank).to.eql('Cadet');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pilot_postman_test\",\n  \"password\": \"Password123!\",\n  \"callsign\": \"Vanguard 1\",\n  \"avatar\": \"pilot_1\",\n  \"ship_class\": \"Interceptor\"\n}"
            },
            "url": {
              "raw": "{{local_api_base}}?action=register",
              "query": [
                {
                  "key": "action",
                  "value": "register"
                }
              ]
            }
          }
        },
        {
          "name": "2.2 Pilot Login (Pre-seeded Account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test('Login returns valid session token', function () {",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data).to.have.property('token');",
                  "    pm.collectionVariables.set('auth_token', json.data.token);",
                  "});",
                  "",
                  "pm.test('Virtual Identity includes career rank and stats', function () {",
                  "    pm.expect(json.data.user).to.have.property('rank');",
                  "    pm.expect(json.data.user).to.have.property('callsign');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"shepard\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{local_api_base}}?action=login",
              "query": [
                {
                  "key": "action",
                  "value": "login"
                }
              ]
            }
          }
        }
      ]
    },
